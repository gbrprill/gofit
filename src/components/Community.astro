---
import { UNITS, UNIT_ORDER, REVIEWS, CTA } from '../data/site';
---
<section class="sec" id="comunidade" aria-labelledby="cm-t" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="h2" id="cm-t">A GOFIT <span class="y">por dentro.</span></h2>
      <p class="lead">O que os alunos dizem sobre treinar aqui.</p>
    </div>
    <div class="com__g">
      {UNIT_ORDER.map((k) => (
        <a class="ig" href={`https://www.instagram.com/${UNITS[k].instagram}/`} target="_blank" rel="noopener">
          <span class="ig__top"><span class="ig__u">{UNITS[k].name}</span><svg aria-hidden="true"><use href="#ig" /></svg></span>
          <span class="ig__n">{UNITS[k].followers.replace(' mil', '')}<small>MIL</small></span>
          <span class="ig__h">@{UNITS[k].instagram}</span>
        </a>
      ))}
    </div>
    <div class="rvw" data-rvw>
      <div class="rvw__vp" tabindex="0" role="region" aria-label="Avaliações de alunos">
        <ul class="rvw__track">
          {REVIEWS.map((r) => (
            <li class="rvw__card">
              <span class="rvw__mark" aria-hidden="true">“</span>
              <blockquote><p>{r.text}</p></blockquote>
              <p class="rvw__who"><b>{r.who}</b><span>{r.source}</span></p>
            </li>
          ))}
        </ul>
      </div>
      <div class="rvw__ctl">
        <button class="hs__nav" type="button" data-rv="-1" aria-label="Avaliação anterior"><svg aria-hidden="true"><use href="#arrl" /></svg></button>
        <button class="hs__nav" type="button" data-rv="1" aria-label="Próxima avaliação"><svg aria-hidden="true"><use href="#arr" /></svg></button>
      </div>
    </div>
    <div class="rvw__join">
      <p class="rvw__jt">Venha fazer parte <span class="y">você também!</span></p>
      <a class="btn btn--y" href="#unidades" data-wa="comunidade" target="_blank" rel="noopener"><svg aria-hidden="true"><use href="#wa" /></svg>{CTA.label}</a>
    </div>
  </div>
</section>

<script>
  // Carrossel: rolagem com encaixe; as setas andam um cartão por vez e dão a volta no fim.
  document.querySelectorAll<HTMLElement>('[data-rvw]').forEach((box) => {
    const vp = box.querySelector<HTMLElement>('.rvw__vp')!;
    box.querySelectorAll<HTMLButtonElement>('[data-rv]').forEach((b) => b.addEventListener('click', () => {
      const card = vp.querySelector<HTMLElement>('.rvw__card');
      if (!card) return;
      const step = card.offsetWidth + 16;
      const max = vp.scrollWidth - vp.clientWidth;
      const dir = Number(b.dataset.rv);
      let to = vp.scrollLeft + dir * step;
      if (to > max + 4) to = 0; else if (to < -4) to = max;
      vp.scrollTo({ left: to, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    }));
  });
</script>
