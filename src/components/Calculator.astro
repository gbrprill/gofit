---
const zones = [
  { p: 0.9, name: 'Força máxima', reps: '1 a 3 reps' },
  { p: 0.8, name: 'Força', reps: '4 a 6 reps' },
  { p: 0.7, name: 'Hipertrofia', reps: '8 a 12 reps' },
  { p: 0.6, name: 'Resistência', reps: '12+ reps' },
];
---
<section class="sec" id="calculadora" aria-labelledby="cl-t" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="h2" id="cl-t">Quanto você <span class="y">levanta?</span></h2>
      <p class="lead">Informe uma série recente e veja sua carga máxima estimada, as zonas de treino e como montar a barra.</p>
    </div>
    <div class="calc__g">
      <form class="calc__in" id="calc" onsubmit="return false">
        <fieldset class="fld">
          <legend>Exercício</legend>
          <div class="seg3">
            <label><input type="radio" name="ex" id="ex-sup" value="Supino" data-kg="80" checked /><span>Supino</span></label>
            <label><input type="radio" name="ex" id="ex-aga" value="Agachamento" data-kg="100" /><span>Agachamento</span></label>
            <label><input type="radio" name="ex" id="ex-ter" value="Terra" data-kg="120" /><span>Terra</span></label>
          </div>
        </fieldset>
        <div class="fld">
          <label for="kg">Carga da série (kg)</label>
          <div class="num"><button type="button" data-step="-2.5" aria-label="Diminuir 2,5 kg">−</button><input id="kg" type="number" inputmode="decimal" min="20" max="400" step="2.5" value="80" /><button type="button" data-step="2.5" aria-label="Aumentar 2,5 kg">+</button></div>
        </div>
        <div class="fld">
          <label for="reps">Repetições completas</label>
          <div class="rng"><input id="reps" type="range" min="1" max="12" step="1" value="6" /><output id="repsv" for="reps">6</output></div>
        </div>
        <p class="calc__disc">Estimativa pela fórmula de Epley. Teste de carga máxima, só com acompanhamento profissional.</p>
      </form>
      <div class="calc__out">
        <div class="calc__rm">
          <div><span class="lbl" id="rmlbl">Carga máxima estimada · Supino</span><div class="calc__rmv" aria-live="polite"><span id="rm">96</span><small>KG</small></div></div>
        </div>
        <table class="zones" id="zones">
          <caption class="sr">Zonas de treino. Escolha uma para montar a barra.</caption>
          <thead><tr><th scope="col">Zona</th><th scope="col">% da máxima</th><th scope="col">Carga</th></tr></thead>
          <tbody>
            {zones.map((z) => (
              <tr data-p={z.p} class:list={{ sel: z.p === 0.8 }}><td><button type="button" aria-pressed={z.p === 0.8 ? 'true' : 'false'}>{z.name} · {z.reps}</button></td><td><span class="pc">{Math.round(z.p * 100)}%</span></td><td><span class="kg">—</span></td></tr>
            ))}
          </tbody>
        </table>
        <div class="bar">
          <div class="bar__viz" id="barviz" role="img" aria-label="Barra montada">
            <div class="bar__side bar__side--l" id="barl"></div>
            <span class="bar__col"></span><span class="bar__shaft"></span><span class="bar__col"></span>
            <div class="bar__side" id="barr"></div>
          </div>
          <div class="bar__txt"><span>Barra olímpica <b>20 kg</b></span><span>Por lado: <b id="perside">—</b></span></div>
        </div>
      </div>
    </div>
  </div>
</section>
