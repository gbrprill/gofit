---
import { UNITS, UNIT_ORDER, CTA, waHref, mapsHref } from '../data/site';
const d = UNITS.fb;
const mapPin = (k: 'rz' | 'fb' | 'pb') => UNITS[k].map;
---
<section class="sec un" id="unidades" aria-labelledby="un-t">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="h2" id="un-t"><span class="ln">Três endereços.</span> <span class="ln y">Um padrão.</span></h2>
      <p class="lead">Escolha sua cidade. Todos os botões do site passam a falar com ela.</p>
    </div>
    <div class="tabs" role="tablist" aria-label="Unidades">
      {UNIT_ORDER.map((k) => (
        <button class="tab" role="tab" id={`tab-${k}`} data-k={k} aria-selected={k === 'fb' ? 'true' : 'false'} tabindex={k === 'fb' ? 0 : -1} aria-controls="upanel"><b>{UNITS[k].short}</b><small>{UNITS[k].role} · desde {UNITS[k].since}</small></button>
      ))}
    </div>
    <div class="un__g">
      <div class="map">
        <svg viewBox="0 0 600 420" role="group" aria-label="Mapa das três unidades no Sudoeste do Paraná">
          <g class="grid" aria-hidden="true">
            <line x1="129" y1="0" x2="129" y2="420" /><line x1="343" y1="0" x2="343" y2="420" /><line x1="557" y1="0" x2="557" y2="420" />
            <line x1="0" y1="74" x2="600" y2="74" /><line x1="0" y1="198" x2="600" y2="198" /><line x1="0" y1="321" x2="600" y2="321" />
          </g>
          <g aria-hidden="true">
            <text class="glbl" x="135" y="410">53°30'O</text><text class="glbl" x="349" y="410">53°O</text><text class="glbl" x="500" y="410">52°30'O</text>
            <text class="glbl" x="10" y="66">25°45'S</text><text class="glbl" x="10" y="190">26°S</text><text class="glbl" x="10" y="313">26°15'S</text>
          </g>
          <path class="route" d={`M${mapPin('rz').x} ${mapPin('rz').y} L${mapPin('fb').x} ${mapPin('fb').y} L${mapPin('pb').x} ${mapPin('pb').y}`} aria-hidden="true" />
          {UNIT_ORDER.map((k) => {
            const p = mapPin(k);
            const left = k === 'pb';
            return (
              <g class:list={['pin', { on: k === 'fb' }]} data-k={k} tabindex="0" role="button" aria-label={`Selecionar ${UNITS[k].name}`}>
                <circle class="halo" cx={p.x} cy={p.y} r="9" />
                <rect class="dot" x={p.x - 9} y={p.y - 9} width="18" height="18" />
                <text class="nm" x={left ? p.x - 20 : p.x + 20} y={left ? p.y - 22 : p.y + 6} text-anchor={left ? 'end' : 'start'}>{UNITS[k].name.toUpperCase()}</text>
              </g>
            );
          })}
        </svg>
      </div>
      <div class="ui" id="upanel" role="tabpanel" aria-labelledby="tab-fb">
        <p class="ui__role" data-f="role">{d.role} · desde {d.since}</p>
        <h3 class="ui__name" data-f="name">{d.name}</h3>
        <p class="ui__q" data-f="quote">{d.quote}</p>
        <dl class="dl">
          <div><dt>Endereço</dt><dd data-f="addr">{d.address} · {d.district}</dd></div>
          <div data-f="hoursrow" hidden={!d.hours}><dt>Horário</dt><dd data-f="hours">{d.hours}</dd></div>
          <div><dt>Treinos</dt><dd data-f="mods">{d.mods.join(' · ')}</dd></div>
          <div><dt>Destaques</dt><dd data-f="feat">{d.highlights.join(' · ')}</dd></div>
          <div><dt>Instagram</dt><dd><a data-f="ig" href={`https://www.instagram.com/${d.instagram}/`} target="_blank" rel="noopener">@{d.instagram}</a></dd></div>
        </dl>
        <div class="ui__acts">
          <a class="btn btn--y" id="uwa" data-wa="unidades" data-unit="fb" href={waHref('fb', CTA.message(d.name), 'unidades')} target="_blank" rel="noopener"><svg aria-hidden="true"><use href="#wa" /></svg><span data-f="cta">Falar com {d.short}</span></a>
          <a class="btn btn--o" data-f="page" href={`/${d.slug}/`}>Ver a unidade<svg class="i-arr" aria-hidden="true"><use href="#arr" /></svg></a>
          <a class="lnk" data-f="maps" href={mapsHref('fb')} target="_blank" rel="noopener"><span>Como chegar</span><svg aria-hidden="true"><use href="#ext" /></svg></a>
        </div>
      </div>
    </div>
  </div>
</section>
