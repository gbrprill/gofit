---
import { CTA } from '../data/site';
// Mesmo vídeo em três faixas, cada uma começando num ponto diferente. No celular só a primeira aparece.
const strips = [
  { t: 0, poster: 'hero-v0' },
  { t: 4.5, poster: 'hero-v1' },
  { t: 11, poster: 'hero-v2' },
];
---
<section class="hero hero--vid" id="hero" aria-labelledby="hero-t">
  <div class="hero__reel" aria-hidden="true">
    {strips.map((s, i) => (
      <div class="hero__strip">
        <picture>
          {i === 0 && <source media="(max-width: 760px)" type="image/webp" srcset={`/img/${s.poster}-540.webp`} />}
          <source type="image/webp" srcset={`/img/${s.poster}-720.webp`} />
          <img src={`/img/${s.poster}-720.jpg`} alt="" width="720" height="1280" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" />
        </picture>
        <video muted loop playsinline disablepictureinpicture preload="none" data-t={s.t} tabindex="-1"></video>
      </div>
    ))}
  </div>
  <div class="hero__shade"></div>
  <div class="wrap hero__in">
    <div class="hero__txt">
      <div class="hero__h">
        <h1 id="hero-t"><span>Treino sério.</span><span class="y">Resultado real.</span></h1>
        <span class="hero__wipe" aria-hidden="true"></span>
      </div>
      <p class="lead" data-intro>Centro de treinamento premium em Realeza, Francisco Beltrão e Pato Branco.</p>
      <div class="hero__cta" data-intro>
        <a class="btn btn--y btn--lg" href="#unidades" data-wa="hero" target="_blank" rel="noopener" data-magnet><svg aria-hidden="true"><use href="#wa" /></svg>{CTA.label}</a>
        <a class="btn btn--o btn--lg" href="#seu-treino" data-magnet>Descobrir meu treino<svg class="i-arr" aria-hidden="true"><use href="#arr" /></svg></a>
      </div>
    </div>
    <div class="hero__side" data-intro>
      <span class="lbl">Desde</span>
      <b>2016</b>
      <a class="scue" href="#placar"><i></i><span>Role</span></a>
    </div>
  </div>
  <button class="hero__play" type="button" id="heroplay" aria-label="Pausar vídeo" hidden>
    <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg>
    <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l12-7.5z" /></svg>
  </button>
  <div class="hero__bar" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <svg><use href="#star" /></svg>)}</div>
</section>
