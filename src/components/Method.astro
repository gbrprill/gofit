---
const steps = [
  { n: '01', t: 'Avaliação', p: 'Entender de onde você parte: objetivo, histórico e condição física.' },
  { n: '02', t: 'Plano', p: 'Treino montado para o seu objetivo, seja hipertrofia, emagrecimento ou condicionamento.' },
  { n: '03', t: 'Execução', p: 'Técnica corrigida no salão e carga ajustada conforme você evolui.' },
  { n: '04', t: 'Reavaliação', p: 'Medir de novo. O que funcionou fica, o que travou muda.' },
];
---
<section class="sec mt" id="metodo" aria-labelledby="mt-t">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="h2" id="mt-t">Suor com <span class="y">método.</span></h2>
      <p class="lead">Treinar pesado é o básico. O que muda o resultado é saber por que cada carga está na barra.</p>
    </div>
    <div class="mt__line" aria-hidden="true"><i></i></div>
    <ol class="mt__g">
      {steps.map((s) => (
        <li class="step"><span class="step__n" aria-hidden="true">{s.n}</span><h3>{s.t}</h3><p>{s.p}</p></li>
      ))}
    </ol>
  </div>
</section>
