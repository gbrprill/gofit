---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import UnitHero from '../components/UnitHero.astro';
import ModCard from '../components/ModCard.astro';
import FinalCta from '../components/FinalCta.astro';
import { UNITS, UNIT_ORDER, MODALITIES, CTA, waHref, mapsHref, type UnitKey } from '../data/site';

export function getStaticPaths() {
  return (['rz', 'fb', 'pb'] as UnitKey[]).map((k) => ({ params: { unidade: UNITS[k].slug }, props: { k } }));
}
const { k } = Astro.props as { k: UnitKey };
const u = UNITS[k];
const mods = MODALITIES.filter((m) => m.units.includes(k));
const others = UNIT_ORDER.filter((x) => x !== k);
const storyImg = k === 'fb' ? 'funcional' : 'halter';
const site = Astro.site!.toString().replace(/\/$/, '');
const ld = {
  '@context': 'https://schema.org',
  '@type': 'ExerciseGym',
  '@id': `${site}/${u.slug}/#gym`,
  name: `GOFIT ${u.name}`,
  url: `${site}/${u.slug}/`,
  image: `${site}/img/og.jpg`,
  parentOrganization: { '@type': 'Organization', name: 'GoFit Premium Gym', url: `${site}/` },
  address: { '@type': 'PostalAddress', streetAddress: u.address, addressLocality: u.city, addressRegion: 'PR', postalCode: u.cep, addressCountry: 'BR' },
  sameAs: `https://www.instagram.com/${u.instagram}/`,
};
---
<Base title={u.seoTitle} description={u.seoDescription} unit={k} ld={ld}>
  <UnitHero k={k} video={k !== 'rz'} />

  <section class="sec" aria-labelledby="st-t">
    <div class="wrap story">
      {k === 'pb'
        ? <div class="story__img zoom" data-reveal><video muted loop playsinline preload="none" poster="/img/panatta-poster-720.webp" data-src="/video/panatta-720.mp4" data-auto aria-label="Máquinas Panatta na unidade Pato Branco"></video></div>
        : <div class="story__img zoom" data-reveal><Pic base={storyImg} alt="" sizes="(max-width: 900px) 100vw, 50vw" /></div>}
      <div class="story__txt">
        <h2 class="h2" id="st-t">{u.story.title}</h2>
        <p class="lead">{u.story.text}</p>
        <ul class="hl">
          {u.highlights.map((h) => <li><svg aria-hidden="true"><use href="#tri" /></svg>{h}</li>)}
        </ul>
        <dl class="dl">
          <div><dt>Endereço</dt><dd>{u.address} · {u.district} · {u.city}/PR</dd></div>
          {u.hours && <div><dt>Horário</dt><dd>{u.hours}</dd></div>}
          <div><dt>Instagram</dt><dd><a href={`https://www.instagram.com/${u.instagram}/`} target="_blank" rel="noopener">@{u.instagram}</a> · {u.followers} seguidores</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="sec mt" aria-labelledby="md-t">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h2" id="md-t">Treinos <span class="y">nesta unidade.</span></h2>
        <p class="lead">Toque em um treino para chamar a equipe de {u.short} já falando dele.</p>
      </div>
      <ul class="mods-grid">
        {mods.map((m) => <ModCard m={m} unit={k} />)}
      </ul>
    </div>
  </section>

  <section class="sec" aria-labelledby="ot-t">
    <div class="wrap">
      <div class="sec-head"><h2 class="h2" id="ot-t">Outras <span class="y">unidades.</span></h2></div>
      <div class="others">
        {others.map((o) => (
          <a class="other" href={`/${UNITS[o].slug}/`}><span>{UNITS[o].role} · desde {UNITS[o].since}</span><b>{UNITS[o].name}</b><span>{UNITS[o].address}</span><svg aria-hidden="true"><use href="#ext" /></svg></a>
        ))}
      </div>
    </div>
  </section>

  <FinalCta unit={k} />
</Base>
